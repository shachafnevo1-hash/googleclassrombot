# Google Gemini API key — FREE at https://aistudio.google.com/app/apikey
# Sign in with your Google account and click "Create API key"
GEMINI_API_KEY=AIza...

# Optional: override the Gemini model (default: gemini-1.5-flash — free tier)
# GEMINI_MODEL=gemini-1.5-flash

# Optional: override max tokens for essay responses (default: 2048)
# GEMINI_MAX_TOKENS=2048

# Optional: path to OAuth2 credentials JSON (default: credentials.json)
# GOOGLE_CREDENTIALS_FILE=credentials.json

# Optional: path to saved OAuth2 token (default: token.json)
# GOOGLE_TOKEN_FILE=token.json
