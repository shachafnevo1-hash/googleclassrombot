# Anthropic Claude API key — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the Claude model (default: claude-opus-4-5)
# CLAUDE_MODEL=claude-opus-4-5

# Optional: override max tokens for essay responses (default: 2048)
# CLAUDE_MAX_TOKENS=2048

# Optional: path to OAuth2 credentials JSON (default: credentials.json)
# GOOGLE_CREDENTIALS_FILE=credentials.json

# Optional: path to saved OAuth2 token (default: token.json)
# GOOGLE_TOKEN_FILE=token.json
